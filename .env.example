# Copy to .env and fill in. .env is ignored by git.

# Any OpenAI-compatible endpoint. Several URLs separated by commas are tried in order (failover).
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1   (LLM_API_KEY can be any non-empty string)
#   vLLM        http://localhost:8000/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Model for drafting, planning and chat, and a second model for the review step.
# A verifier from another model family catches more of the author's mistakes.
REFRACT_MODEL=gpt-4o-mini
REFRACT_VERIFIER_MODEL=

# Language of insights: ru or en
REFRACT_LANGUAGE=ru

# Optional
# REFRACT_EMBEDDING_MODEL=text-embedding-3-small   # enables hybrid BM25 + dense retrieval
# REFRACT_DATA_DIR=examples/demo
# REFRACT_CONFIG=refract.toml
# REFRACT_API_TOKEN=                               # require a bearer token on the REST API
# LLM_TIMEOUT_S=120
# LLM_CACHE_DIR=.cache/llm
# LLM_LOG_PATH=logs/llm_calls.jsonl
