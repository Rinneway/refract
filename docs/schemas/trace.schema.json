{
  "$defs": {
    "ReaderRole": {
      "description": "Who reads the insight. The role sets depth, tone and which blocks are expanded.",
      "enum": [
        "owner",
        "ceo",
        "cfo",
        "chief_accountant",
        "treasurer",
        "entrepreneur",
        "individual",
        "other"
      ],
      "title": "ReaderRole",
      "type": "string"
    },
    "StepKind": {
      "enum": [
        "plan",
        "tool_call",
        "llm_call",
        "draft",
        "verify",
        "revise",
        "finalize",
        "error"
      ],
      "title": "StepKind",
      "type": "string"
    },
    "TraceStep": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/StepKind"
        },
        "name": {
          "description": "Tool or step name, e.g. search_research",
          "title": "Name",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool"
        },
        "input_summary": {
          "default": "",
          "title": "Input Summary",
          "type": "string"
        },
        "output_summary": {
          "default": "",
          "title": "Output Summary",
          "type": "string"
        },
        "tokens_in": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens Out",
          "type": "integer"
        },
        "cost": {
          "default": 0.0,
          "description": "Cost in the trace currency",
          "minimum": 0,
          "title": "Cost",
          "type": "number"
        },
        "cached": {
          "default": false,
          "title": "Cached",
          "type": "boolean"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "verdict": {
          "anyOf": [
            {
              "enum": [
                "ok",
                "issues",
                "failed",
                "skipped"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "index",
        "kind",
        "name",
        "started_at"
      ],
      "title": "TraceStep",
      "type": "object"
    },
    "TraceTotals": {
      "additionalProperties": false,
      "properties": {
        "llm_calls": {
          "default": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "tokens_in": {
          "default": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "default": 0,
          "title": "Tokens Out",
          "type": "integer"
        },
        "cost": {
          "default": 0.0,
          "title": "Cost",
          "type": "number"
        },
        "latency_ms": {
          "default": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "iterations": {
          "default": 0,
          "title": "Iterations",
          "type": "integer"
        }
      },
      "title": "TraceTotals",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "role": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReaderRole"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "language": {
      "default": "ru",
      "title": "Language",
      "type": "string"
    },
    "insight_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Insight Id"
    },
    "config": {
      "additionalProperties": true,
      "description": "Agent configuration of the run (for ablations)",
      "title": "Config",
      "type": "object"
    },
    "currency": {
      "default": "USD",
      "title": "Currency",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "status": {
      "default": "running",
      "enum": [
        "running",
        "done",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/TraceStep"
      },
      "title": "Steps",
      "type": "array"
    },
    "totals": {
      "$ref": "#/$defs/TraceTotals"
    }
  },
  "required": [
    "trace_id",
    "profile_id",
    "event_id",
    "started_at"
  ],
  "title": "Trace",
  "type": "object"
}
