{
  "$defs": {
    "ChatIntent": {
      "enum": [
        "clarify",
        "slice",
        "source",
        "out_of_scope"
      ],
      "title": "ChatIntent",
      "type": "string"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "One statement with its origin, sources and the subject's features it relies on.",
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "features": {
          "description": "Feature keys of the subject the statement relies on, e.g. products.loans",
          "items": {
            "type": "string"
          },
          "title": "Features",
          "type": "array"
        },
        "confidence": {
          "description": "Confidence from 0 to 1",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "caveat": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Caveat: an assumption, missing data or disagreement with the house view",
          "title": "Caveat"
        }
      },
      "required": [
        "claim_id",
        "text",
        "origin",
        "confidence"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Origin": {
      "description": "Where a statement comes from. The reader always sees it next to the statement.",
      "enum": [
        "fact",
        "house_view",
        "ai",
        "hypothesis"
      ],
      "title": "Origin",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "A source that statements cite: a news article, a research page, the subject's data.",
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SourceType"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Page of a research document",
          "title": "Page"
        },
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Quote that supports a statement",
          "title": "Excerpt"
        }
      },
      "required": [
        "source_id",
        "type",
        "title"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "news",
        "research",
        "profile",
        "payments",
        "public_stats",
        "user_input"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "insight_id": {
      "title": "Insight Id",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "intent": {
      "$ref": "#/$defs/ChatIntent"
    },
    "answer": {
      "title": "Answer",
      "type": "string"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Sources",
      "type": "array"
    },
    "follow_ups": {
      "items": {
        "type": "string"
      },
      "title": "Follow Ups",
      "type": "array"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    },
    "language": {
      "default": "ru",
      "title": "Language",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "disclaimer": {
      "default": "",
      "title": "Disclaimer",
      "type": "string"
    }
  },
  "required": [
    "insight_id",
    "question",
    "intent",
    "answer",
    "created_at"
  ],
  "title": "ChatResponse",
  "type": "object"
}
